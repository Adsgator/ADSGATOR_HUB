# ADSGATOR HUB — Rooignore
# Arquivos e diretórios que Roo Code deve ignorar

# Dependências
node_modules/
.pnpm-store/

# Build e cache
.next/
out/
dist/
build/

# Cache e telemetria Next.js
.next/cache/
.vercel/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Variáveis de ambiente (contêm segredos)
.env
.env.local
.env.*.local
.env.production

# Supabase temporários
supabase/.temp/

# Git
.git/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
*.swo

# Dados de dump/snapshot (arquivos grandes gerados)
project_snapshot.md
src/dump_project.py

# Lock files (leitura raramente útil)
package-lock.json
yarn.lock
pnpm-lock.yaml
